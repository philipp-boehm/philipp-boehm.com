---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Philipp Böhm | Software Engineer">
	<main class="max-w-3xl mx-auto px-6 py-24 md:py-32">
		
		<section class="mb-24 fade-in">
			<span class="inline-block py-1 px-3 rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-semibold tracking-wide text-slate-600 dark:text-slate-400 mb-6">
				Verfügbar für Projekte
			</span>
			<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-tight">
				Software Engineer & <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">
					Architekt.
				</span>
			</h1>
			<p class="text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl">
				Ich entwickle skalierbare Webanwendungen und digitale Ökosysteme. 
				Fokus auf Performance, Clean Code und intuitive Nutzererfahrung.
			</p>
		</section>

		<section class="mb-24">
			<h2 class="text-sm font-bold uppercase tracking-widest text-slate-500 mb-8">Technologie-Stack</h2>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				{["Java", "Python", "TypeScript", "Astro", "Laravel", "SQL", "Docker", "Git"].map((tech) => (
					<div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 hover:border-blue-500/50 transition-colors text-center font-medium text-sm">
						{tech}
					</div>
				))}
			</div>
		</section>

		<section class="mb-24">
			<div class="flex justify-between items-baseline mb-12">
				<h2 class="text-3xl font-bold tracking-tight">Ausgewählte Projekte</h2>
				<a href="https://github.com/philipp-boehm" target="_blank" class="text-blue-600 hover:text-blue-500 text-sm font-medium transition-colors">GitHub Profil &rarr;</a>
			</div>

			<div class="space-y-12">
				
				<div class="group relative block overflow-hidden rounded-2xl bg-black border border-slate-800 transition-all hover:shadow-2xl hover:shadow-cyan-500/20 hover:scale-[1.01]">
					
					<div class="absolute inset-0 bg-gradient-to-t from-black via-slate-900/80 to-slate-900/40 z-10"></div>
					
					<div class="relative z-20 p-8 h-full flex flex-col justify-between">
						<div>
							<div class="flex justify-between items-start mb-4">
								<h3 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500" style="font-family: 'Courier New', monospace;">
									NEON RUNNER
								</h3>
								<span class="text-xs font-mono text-cyan-400 border border-cyan-900 bg-cyan-950/30 px-2 py-1 rounded">Interactive</span>
							</div>
							<p class="text-slate-300 mb-6 max-w-lg">
								Ein browserbasiertes 3D-Endless-Runner Spiel. Entwickelt mit JavaScript und Three.js. 
								Features: Prozedurale Generierung, Kollisionserkennung und Audio-Synthese.
							</p>
						</div>

						<div class="flex flex-wrap gap-4 items-center mt-4">
							<a href="/neon-runner.html" target="_blank" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-500 hover:bg-cyan-400 text-black font-bold rounded-full transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
								</svg>
								Jetzt spielen
							</a>
							
							<div class="flex gap-2 text-xs text-slate-500 font-mono">
								<span>Three.js</span>
								<span>•</span>
								<span>HTML5 Canvas</span>
							</div>
						</div>
					</div>
				</div>

				<div class="group relative block overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 transition-all hover:shadow-xl hover:scale-[1.01]">
					<div class="p-8">
						<div class="flex justify-between items-start mb-4">
							<h3 class="text-xl font-bold">Portfolio V1</h3>
							<span class="text-xs font-mono text-slate-500">2025</span>
						</div>
						<p class="text-slate-600 dark:text-slate-400 mb-6">
							Ein hochperformantes, statisches Portfolio basierend auf Astro und Tailwind CSS. 
							Automatisiertes Deployment via GitHub Actions und SSH auf IONOS Webspace.
						</p>
						<div class="flex gap-2">
							<span class="px-2 py-1 bg-white dark:bg-slate-800 rounded text-xs border border-slate-200 dark:border-slate-700">Astro</span>
							<span class="px-2 py-1 bg-white dark:bg-slate-800 rounded text-xs border border-slate-200 dark:border-slate-700">CI/CD</span>
						</div>
					</div>
				</div>

				<div class="group relative block overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 opacity-75">
					<div class="p-8">
						<div class="flex justify-between items-start mb-4">
							<h3 class="text-xl font-bold">Personal Dashboard</h3>
							<span class="text-xs font-mono text-orange-500">In Entwicklung</span>
						</div>
						<p class="text-slate-600 dark:text-slate-400 mb-6">
							Eine private Verwaltungszentrale für Notizen, Medien und Finanzen. 
							Geschützter Login-Bereich mit strikter Trennung von Frontend und Backend.
						</p>
						<div class="flex gap-2">
							<span class="px-2 py-1 bg-white dark:bg-slate-800 rounded text-xs border border-slate-200 dark:border-slate-700">Laravel</span>
							<span class="px-2 py-1 bg-white dark:bg-slate-800 rounded text-xs border border-slate-200 dark:border-slate-700">MySQL</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<footer class="pt-12 border-t border-slate-200 dark:border-slate-800 text-center md:text-left">
			<div class="flex flex-col md:flex-row justify-between text-slate-500 text-sm">
				<p>&copy; {new Date().getFullYear()} Philipp Böhm. All rights reserved.</p>
				<div class="flex gap-6 mt-4 md:mt-0">
					<a href="/impressum" class="hover:text-slate-900 dark:hover:text-white transition-colors">Impressum</a>
					<a href="#" class="hover:text-slate-900 dark:hover:text-white transition-colors">Datenschutz</a>
				</div>
			</div>
		</footer>

	</main>
</Layout>