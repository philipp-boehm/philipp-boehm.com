---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	noIndex?: boolean;
}

const { title, noIndex = false } = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		
		<meta name="description" content="Portfolio und digitales Zuhause von Philipp Böhm" />
		
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		{noIndex && <meta name="robots" content="noindex, nofollow" />}

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-900 dark:bg-[#0a0a0a] dark:text-white antialiased selection:bg-blue-500 selection:text-white">
		<Header /> 
		<slot />
	</body>
</html>

<style is:global>
	/* Apple-System Fonts Fallback */
	html {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	}
</style>